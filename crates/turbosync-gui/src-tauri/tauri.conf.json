{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "飞梭同步",
    "version": "0.1.0"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://127.0.0.1:1420",
    "distDir": "../dist"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "dev.turbosync.gui",
      "icon": [
        "icons/32x32.png",
        "icons/64x64.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/256x256.png",
        "icons/512x512.png",
        "icons/1024x1024.png",
        "icons/icon.png",
        "icons/icon.ico",
        "icons/icon.icns",
        "icons/icon-1024.png"
      ]
    },
    "windows": [
      {
        "title": "飞梭同步",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
